generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ═══════════════════════════════════════════════════════════════
   PHASE 1: CORE SERVICES & PLUGINS (Existing)
   ═══════════════════════════════════════════════════════════════ */

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String   @default("#002B5C")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  Service[]
  plans     Plan[]
}

model Service {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  shortDescription      String   @default("")
  description           String   @default("")
  price                 Float
  icon                  String   @default("FileText")
  image                 String   @default("")
  color                 String   @default("#002B5C")
  turnaround            Int      @default(0) // days
  buttonLabel           String   @default("ADD TO CART")
  buttonType            String   @default("cart") // cart | quote | booking | link
  buttonUrl             String   @default("")
  woocommerceProductId  String   @default("")
  categoryId            String?
  visible               Boolean  @default(true)
  featured              Boolean  @default(false)
  displayOrder          Int      @default(0)
  questionnaireTemplateId String?
  agreementTemplateId     String?
  requiredDocuments     String   @default("[]") // JSON: [{name, required, category}]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questionnaireTemplate QuestionnaireTemplate?  @relation("ServiceQuestionnaire", fields: [questionnaireTemplateId], references: [id], onDelete: SetNull)
  agreementTemplate     AgreementTemplate?     @relation("ServiceAgreement", fields: [agreementTemplateId], references: [id], onDelete: SetNull)
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  subtitle          String   @default("")
  price             Float
  color             String   @default("#002B5C")
  buttonLabel       String   @default("GET STARTED")
  buttonType        String   @default("cart")
  buttonUrl         String   @default("")
  woocommerceProductId String @default("")
  categoryId        String?
  visible           Boolean  @default(true)
  featured          Boolean  @default(false)
  displayOrder      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  features          PlanFeature[]
}

model PlanFeature {
  id        String   @id @default(cuid())
  text      String
  planId    String
  createdAt DateTime @default(now())

  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PluginSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Icon {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  svgPath     String
  category    String   @default("general")
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ═══════════════════════════════════════════════════════════════
   PHASE 2: QUESTIONNAIRE BUILDER
   Reusable questionnaire templates with sections, questions,
   conditional logic, and file upload support.
   ═══════════════════════════════════════════════════════════════ */

model QuestionnaireTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  version     String   @default("1.0")
  status      String   @default("draft") // draft | published | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    QuestionnaireSection[]
  services    Service[]               @relation("ServiceQuestionnaire")
  projects    ProjectQuestionnaire[]
}

model QuestionnaireSection {
  id           String   @id @default(cuid())
  templateId   String
  title        String
  description  String   @default("")
  displayOrder Int      @default(0)
  isShared     Boolean  @default(false) // shared across services (e.g., Company Profile)
  createdAt    DateTime @default(now())

  template     QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions    QuestionnaireQuestion[]
}

model QuestionnaireQuestion {
  id              String   @id @default(cuid())
  sectionId       String
  type            String   @default("text") // text, textarea, select, multiselect, number, email, phone, date, file, radio, checkbox, heading, paragraph
  label           String
  placeholder     String   @default("")
  required        Boolean  @default(false)
  options         String   @default("[]") // JSON array for select/radio/checkbox
  conditionalOn   String   @default("") // question ID this depends on
  conditionalValue String   @default("") // value that triggers showing this question
  helpText        String   @default("")
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  section         QuestionnaireSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

/* ═══════════════════════════════════════════════════════════════
   PHASE 2: AGREEMENT TEMPLATES
   Digital agreements (e.g., Confidentiality Undertaking)
   with versioning and electronic signature support.
   ═══════════════════════════════════════════════════════════════ */

model AgreementTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  content     String   @default("") // HTML content of the agreement
  version     String   @default("1.0")
  status      String   @default("draft") // draft | published | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]               @relation("ServiceAgreement")
  projects    ProjectAgreement[]
}

/* ═══════════════════════════════════════════════════════════════
   PHASE 2: CLIENT PROJECTS
   Every paid WooCommerce order creates a BusinessVance Project.
   Tracks the full workflow: agreement → questionnaire → documents → delivery.
   ═══════════════════════════════════════════════════════════════ */

model Project {
  id                  String   @id @default(cuid())
  projectNumber       String   @unique
  clientName          String
  clientEmail         String
  clientPhone         String   @default("")
  clientCompany       String   @default("")
  woocommerceOrderId  String   @default("")
  status              String   @default("awaiting-agreement") // awaiting-agreement, awaiting-questionnaire, awaiting-documents, information-review, in-progress, quality-check, completed, delivered, archived
  progressPercent     Int      @default(0)
  notes               String   @default("")
  assignedTo          String   @default("")
  internalNotes       String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  services            ProjectService[]
  agreements          ProjectAgreement[]
  questionnaires      ProjectQuestionnaire[]
  documents           ProjectDocument[]
}

model ProjectService {
  id        String   @id @default(cuid())
  projectId String
  serviceId String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAgreement {
  id          String   @id @default(cuid())
  projectId   String
  templateId  String
  fullName    String
  ipAddress   String   @default("")
  userAgent   String   @default("")
  agreedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    AgreementTemplate @relation(fields: [templateId], references: [id])
}

model ProjectQuestionnaire {
  id          String   @id @default(cuid())
  projectId   String
  templateId  String
  status      String   @default("pending") // pending, in-progress, completed
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id])
  responses   ProjectResponse[]
}

model ProjectResponse {
  id              String   @id @default(cuid())
  questionnaireId String
  questionId      String
  value           String   @default("")
  createdAt       DateTime @default(now())

  questionnaire   ProjectQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

model ProjectDocument {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  filename    String
  filepath    String
  filesize    Int      @default(0)
  mimeType    String   @default("")
  category    String   @default("other") // company-registration, id, financial, logo, branding, other
  uploadedBy  String   @default("")
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
